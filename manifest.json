{
  "manifest_version": 3,
  "name": "Grammer2",
  "version": "1.0",
  "description": "An extension for real-time grammar, spelling, and rephrasing suggestions.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/scripts/content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
